# PDFATY configuration (copy to .env). No secrets are required.

# Port the server listens on (Hugging Face Spaces uses 7860; Render/Fly inject PORT automatically)
PORT=7860

# Upload limits
PDFATY_MAX_UPLOAD_MB=100          # per file
PDFATY_MAX_TOTAL_MB=250           # per request
PDFATY_MAX_FILES=30               # files per request
PDFATY_MAX_PAGES=2000             # pages per document

# Processing limits
PDFATY_JOB_TIMEOUT=300            # seconds per operation
PDFATY_OCR_TIMEOUT=1800           # seconds for OCR / compare
PDFATY_MAX_CONCURRENT_JOBS=2      # jobs processed in parallel (CPU bound)
PDFATY_MAX_QUEUE=30               # queued+running jobs before "server busy"
PDFATY_MAX_ACTIVE_JOBS_PER_IP=4
PDFATY_RATE_LIMIT_PER_MIN=40      # new jobs per minute per client IP
PDFATY_WORKER_MEMORY_MB=3072      # address-space limit for each worker process

# Retention: results are deleted on download, or after this many seconds at most
PDFATY_RESULT_TTL=900

# Set to 1 only when running behind a trusted reverse proxy (HTTPS hosting platforms)
PDFATY_TRUST_PROXY=1

# Where temporary job folders live (must be writable)
PDFATY_TMP_DIR=/tmp/pdfaty-jobs

# Built frontend directory served by the API
PDFATY_STATIC_DIR=../frontend/dist

PDFATY_LOG_LEVEL=INFO
